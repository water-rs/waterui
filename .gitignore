.DS_Store
target
.water
apple/DerivedData
apple/build
*.xcworkspace/xcuserdata
web/pkg
.build
*.log
/.cargo/*
!/.cargo/config.toml
*.rlib

# Personal/temporary files
*.skill
bugreport*.zip
.worktrees/
.wrangler/
node_modules/

# Apple e2e / release-metrics scratch directories CI produces at the
# workspace root (artifacts, not source).
e2e-logs/
e2e-shots/
e2e-baselines/
packaged-ios/
packaged-macos/
packaged-artifacts/
release-metrics*/
water-cli/
cli-bin/
native-reference/

# Claude Code runtime artifacts (per-session, not source)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Override macOS-style global ignore patterns that catch repo paths on
# case-insensitive APFS (e.g. a user global ignoring `Icon` for Finder
# metadata also catches our `components/icon/` directory).
!components/foundation/icon
!components/foundation/icon/
!components/foundation/icon/**
!components/icon
!components/icon/
!components/icon/**

# Binary assets (hosted on assets.waterui.dev)
*.png
*.heic
*.jpg
*.jpeg

# Icon set source data under `components/icon/*/data/` is deliberately
# vendored and tracked so icon crates build offline and reproducibly.
# Do not add an ignore rule for it.

# Python bytecode from the release-script tests and the scene generators
__pycache__/
*.pyc

# Generated Cherenkov scene tree: `graphics/cherenkov/scenes/tools/generate.py`
# rebuilds all of it (fetch -> fonts -> test fonts -> corpus -> perf) from
# pinned, hash-verified sources.
graphics/cherenkov/out/
graphics/cherenkov/scenes/corpus/
graphics/cherenkov/scenes/perf/
graphics/cherenkov/scenes/fonts/_full/
graphics/cherenkov/scenes/fonts/*.ttf
graphics/cherenkov/scenes/fonts/OFL.txt
