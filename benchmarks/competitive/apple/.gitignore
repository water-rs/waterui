# build outputs: the build host's staged set and tarball, the device
# host's run dirs (build/device-runs/) — never committed
build/
**/build/
**/DerivedData/
**/*.xcresult
**/xcuserdata/

# generated by xcodegen from the committed project.yml at bootstrap
# (native-bench, build host) and at the runner build (xctest, device host)
native-bench/NativeBench.xcodeproj/
xctest/BenchRunner.xcodeproj/

# uv-managed interpreter (pyproject/.python-version)
.venv/
__pycache__/
