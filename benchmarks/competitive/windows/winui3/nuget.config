<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the package source restore needs, so a freshly provisioned
     .NET SDK with no configured sources never fails with NU1100 —
     restore must not depend on host configuration. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
