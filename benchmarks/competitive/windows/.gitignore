# Build outputs and run artifacts — never commit these.
out/
results/
apps/*/dist/
apps/waterui/backends/hydrolysis/dist/
apps/flutter/build/
apps/flutter/.dart_tool/
apps/flutter/.flutter-plugins*
apps/flutter/windows/flutter/ephemeral/
# Generated by `flutter create` (framework template) — never committed.
apps/flutter/windows/runner/resources/app_icon.ico
# Staged by `water package` (water CLI owns these outputs): the app icon
# comes from the CLI's project icon generator and resources/ from
# `water fetch` + copy_assets_and_fonts — never committed.
apps/waterui/backends/hydrolysis/app-icon.ico
apps/waterui/backends/hydrolysis/resources/
apps/electron/node_modules/
apps/waterui/target/
apps/winui3/bin/
apps/winui3/obj/
*.etl
*.csv
__pycache__/
.venv/
