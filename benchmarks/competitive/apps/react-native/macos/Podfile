require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

prepare_react_native_project!

target 'RnBench-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # RnBench-macOS compiles ObjC++ (AppDelegate.mm), so Xcode links it
    # through clang++, whose driver already passes -lc++ to ld. The Pods
    # aggregate xcconfig adds the pods' declared `c++` library on top,
    # and ld reports "ignoring duplicate libraries: '-lc++'". Drop it
    # from the aggregate xcconfigs so libc++ is linked once, by the
    # driver. (The iOS app's AppDelegate is Swift: no clang++ driver, so
    # its Pods -lc++ is the only one and stays.)
    installer.aggregate_targets.each do |aggregate|
      aggregate.xcconfigs.each do |variant, xcconfig|
        unless xcconfig.libraries.include?('c++')
          raise "#{aggregate.name} #{variant} xcconfig no longer declares " \
                "-lc++; re-check the link line before editing it"
        end
        xcconfig.libraries.delete('c++')
        xcconfig.save_as(aggregate.xcconfig_path(variant))
      end
    end

    # fmt 12.1.0's consteval format-string check does not compile on Apple
    # clang 21 (Xcode 26.4+): https://github.com/fmtlib/fmt/issues/4740
    # Upstream fix is an FMT_USE_CONSTEVAL=0 path for Apple clang; apply the
    # documented one-line patch to the vendored header.
    fmt_base = File.join(__dir__, 'Pods/fmt/include/fmt/base.h')
    if File.exist?(fmt_base)
      src = File.read(fmt_base)
      patched = src.sub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      File.write(fmt_base, patched) if patched != src
    end
  end
end
